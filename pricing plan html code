    <script>
        // Tab Switching Logic for Modular Pricing
        function switchTab(tabId) {
            // Hide all tabs
            document.querySelectorAll('.tab-content').forEach(el => {
                el.classList.remove('active');
            });
            // Show selected tab
            document.getElementById('tab-' + tabId).classList.add('active');

            // Update button styles for active state
            const btnNocode = document.getElementById('btn-nocode');
            const btnCustom = document.getElementById('btn-custom');

            if (tabId === 'nocode') {
                btnNocode.className = "px-6 py-3 rounded-lg text-sm font-semibold transition-all duration-200 bg-white shadow-md text-brand-600";
                btnCustom.className = "px-6 py-3 rounded-lg text-sm font-semibold transition-all duration-200 text-slate-600 hover:text-slate-900 mt-2 sm:mt-0 sm:ml-2";
            } else {
                btnCustom.className = "px-6 py-3 rounded-lg text-sm font-semibold transition-all duration-200 bg-white shadow-md text-brand-600 mt-2 sm:mt-0 sm:ml-2";
                btnNocode.className = "px-6 py-3 rounded-lg text-sm font-semibold transition-all duration-200 text-slate-600 hover:text-slate-900";
            }
        }
    </script>
