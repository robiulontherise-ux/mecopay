    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.25",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.20.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.5.5",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.12",
    "express": "^4.21.2",
    "framer-motion": "^12.42.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.27.0",
    "motion": "^12.23.24",
